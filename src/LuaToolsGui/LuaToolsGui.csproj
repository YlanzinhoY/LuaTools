<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>LuaTools</AssemblyName>
    <AssemblyTitle>LuaTools</AssemblyTitle>
    <Product>LuaTools</Product>
    <Version>1.2.33</Version>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <!-- Velopack needs a custom Main (Program.Main) that runs before WPF -->
    <StartupObject>LuaToolsGui.Program</StartupObject>
    <BuildAchievementBridge Condition="'$(BuildAchievementBridge)' == ''">true</BuildAchievementBridge>
    <AchievementBridgeSource>$(MSBuildProjectDirectory)\..\AchievementBridge</AchievementBridgeSource>
    <AchievementBridgeBuildScript>$(MSBuildProjectDirectory)\..\..\scripts\build-achievement-bridge.ps1</AchievementBridgeBuildScript>
    <BuildCanIRunIt Condition="'$(BuildCanIRunIt)' == ''">true</BuildCanIRunIt>
    <CanIRunItSource>$(MSBuildProjectDirectory)\..\CanIRunItBackend</CanIRunItSource>
    <CanIRunItBuildScript>$(MSBuildProjectDirectory)\..\..\scripts\build-can-i-run-it.ps1</CanIRunItBuildScript>
  </PropertyGroup>

  <!-- UseWindowsForms (for the tray NotifyIcon) injects WinForms into the implicit global usings, which
       collides with WPF types (Application, UserControl, DragEventArgs…). We reference WinForms fully
       qualified, so strip those implicit usings to keep WPF unambiguous. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- Let the test project reach internal members (e.g. Program.MatchOsLanguage). -->
  <ItemGroup>
    <InternalsVisibleTo Include="LuaToolsGui.Tests" />
  </ItemGroup>

  <!-- Make App.xaml a Page so the SDK doesn't auto-generate a Main that conflicts with Program.Main -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <!-- Embed icon.ico as a resource so the Window Icon="icon.ico" can resolve it at runtime -->
  <ItemGroup>
    <Resource Include="icon.ico" />
  </ItemGroup>

  <!-- Release packaging may place the independently built Zig bridge here. Development builds remain
       valid when it is absent; ACHIEVEMENT_BRIDGE_PATH can point at a local binary. -->
  <ItemGroup Condition="Exists('AchievementBridge\achievement-bridge.exe')">
    <Content Include="AchievementBridge\achievement-bridge.exe" CopyToOutputDirectory="PreserveNewest" Link="AchievementBridge\achievement-bridge.exe" />
    <Content Include="AchievementBridge\achievement-bridge-cloud.dll" Condition="Exists('AchievementBridge\achievement-bridge-cloud.dll')" CopyToOutputDirectory="PreserveNewest" Link="AchievementBridge\achievement-bridge-cloud.dll" />
  </ItemGroup>

  <Target Name="CompileAchievementBridge"
          AfterTargets="Build"
          Condition="'$(BuildAchievementBridge)' == 'true' and '$(OS)' == 'Windows_NT' and Exists('$(AchievementBridgeSource)\build.zig')">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(AchievementBridgeBuildScript)&quot; -ProjectDir &quot;$(AchievementBridgeSource)&quot; -OutputDir &quot;$(TargetDir)AchievementBridge&quot; -Configuration &quot;$(Configuration)&quot;" />
  </Target>

  <Target Name="PublishAchievementBridge"
          AfterTargets="Publish"
          Condition="'$(BuildAchievementBridge)' == 'true' and '$(OS)' == 'Windows_NT' and '$(PublishDir)' != '' and Exists('$(AchievementBridgeSource)\build.zig')">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(AchievementBridgeBuildScript)&quot; -ProjectDir &quot;$(AchievementBridgeSource)&quot; -OutputDir &quot;$(PublishDir)AchievementBridge&quot; -Configuration &quot;$(Configuration)&quot;" />
  </Target>

  <!-- The hardware/AI analysis is an isolated Go sidecar. The OpenRouter key is supplied only at
       runtime and is never compiled into either binary. -->
  <Target Name="CompileCanIRunIt"
          AfterTargets="Build"
          Condition="'$(BuildCanIRunIt)' == 'true' and '$(OS)' == 'Windows_NT' and Exists('$(CanIRunItSource)\go.mod')">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(CanIRunItBuildScript)&quot; -ProjectDir &quot;$(CanIRunItSource)&quot; -OutputDir &quot;$(TargetDir)CanIRunIt&quot;" />
  </Target>

  <Target Name="PublishCanIRunIt"
          AfterTargets="Publish"
          Condition="'$(BuildCanIRunIt)' == 'true' and '$(OS)' == 'Windows_NT' and '$(PublishDir)' != '' and Exists('$(CanIRunItSource)\go.mod')">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(CanIRunItBuildScript)&quot; -ProjectDir &quot;$(CanIRunItSource)&quot; -OutputDir &quot;$(PublishDir)CanIRunIt&quot;" />
  </Target>

  <!-- Built-in metadata for game-specific local achievement viewers. It enriches the minimal R2
       schema with Steam metadata (for example icon URLs) and works without manual setup. -->
  <ItemGroup>
    <Content Include="Assets\Achievements\*.json" CopyToOutputDirectory="PreserveNewest" Link="Achievements\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Nothing in public/ is bundled anymore. The frontend (luatools.js) is fetched from GitHub releases
       by PluginInstallerService into %AppData%\LuaToolsGui\plugin; the Millennium-aware polyfill is inline
       (CefInjectorService.BuildInlinePolyfill); and the manifest-source list falls back to the hardcoded
       defaults in HttpServerService when api.json is absent. -->


  <!-- Localization RESX. We hand-maintain Strings.Designer.cs (works under dotnet watch), so disable the
       SDK's auto-generated designer to avoid a duplicate Strings class. zh-Hans builds a satellite asm. -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings*.resx">
      <Generator></Generator>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Markdig.Wpf" Version="0.5.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.9" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <PackageReference Include="VirtualizingWrapPanel" Version="2.5.1" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>

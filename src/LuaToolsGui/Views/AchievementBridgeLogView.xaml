<UserControl
    x:Class="LuaToolsGui.Views.AchievementBridgeLogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:AchievementBridgeLogViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid Margin="8,16,16,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="22" FontWeight="Bold" Text="{x:Static res:Strings.BridgeLogs_Title}" />
            <TextBlock Margin="0,2,0,0" FontSize="13" Foreground="#9ca3af"
                       Text="{x:Static res:Strings.BridgeLogs_Subtitle}" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,18,0,12" Padding="16,12" Background="#0DFFFFFF"
                BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0" Width="9" Height="9" Margin="0,0,9,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#f59e0b" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Fill" Value="#22c55e" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding StatusText}" />
                <TextBlock Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="#9ca3af"
                           Text="{Binding ProcessText}" />
                <TextBlock Grid.Column="3" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="#9ca3af"
                           Text="{Binding ActiveGamesText}" />
                <ui:Button Grid.Column="4" Margin="8,0" Command="{Binding OpenFolderCommand}"
                           Content="{x:Static res:Strings.BridgeLogs_OpenFolder}" />
                <ui:Button Grid.Column="5" Command="{Binding ClearCommand}"
                           Content="{x:Static res:Strings.BridgeLogs_Clear}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Border Background="#12000000" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="10">
                <ListBox x:Name="LogList" ItemsSource="{Binding Entries}" Background="Transparent"
                         BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="105" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontFamily="Consolas" FontSize="11.5" Foreground="#7c8593" Text="{Binding Time}" />
                                <TextBlock Grid.Column="1" FontFamily="Consolas" FontSize="11" Foreground="#a78bfa" Text="{Binding LevelText}" />
                                <TextBlock Grid.Column="2" FontSize="11.5" FontWeight="SemiBold" Foreground="#93c5fd" Text="{Binding Category}" />
                                <TextBlock Grid.Column="3" FontFamily="Consolas" FontSize="11.5" Foreground="#d1d5db"
                                           Text="{Binding Message}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding HasEntries, Converter={StaticResource InverseBoolToVis}}">
                <ui:SymbolIcon HorizontalAlignment="Center" FontSize="30" Foreground="#6b7280" Symbol="Games24" />
                <TextBlock Margin="0,10,0,0" Foreground="#9ca3af" Text="{x:Static res:Strings.BridgeLogs_Empty}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

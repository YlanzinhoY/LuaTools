<Window
    x:Class="LuaToolsGui.Views.AchievementUnlockedWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Achievement unlocked"
    Width="430"
    Height="126"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowActivated="False"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStyle="None">

    <Border
        Margin="5"
        Padding="14"
        Background="#f51b1d24"
        BorderBrush="#667c3aed"
        BorderThickness="1"
        CornerRadius="13"
        MouseLeftButtonUp="Popup_Click">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="18"
                Opacity="0.55"
                ShadowDepth="4"
                Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="78" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Width="68" Height="68">
                <Border
                    Background="#22000000"
                    ClipToBounds="True"
                    CornerRadius="9">
                    <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                </Border>
                <Border
                    Width="24"
                    Height="24"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="#e5111827"
                    CornerRadius="12">
                    <ui:SymbolIcon
                        FontSize="19"
                        Foreground="#4ade80"
                        Symbol="CheckmarkCircle24" />
                </Border>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    FontSize="10.5"
                    FontWeight="Bold"
                    Foreground="#4ade80"
                    Text="{Binding Header}" />
                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="#f3f4f6"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Margin="0,3,0,0"
                    FontSize="11.5"
                    Foreground="#c0c4cc"
                    MaxHeight="34"
                    Text="{Binding Description}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

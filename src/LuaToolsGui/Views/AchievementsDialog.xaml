<ui:FluentWindow
    x:Class="LuaToolsGui.Views.AchievementsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    Title="{x:Static res:Strings.Achievements_Title}"
    Width="820"
    Height="680"
    MinWidth="620"
    MinHeight="480"
    d:DataContext="{d:DesignInstance Type=vm:AchievementsViewModel}"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="CanResize"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{x:Static res:Strings.Achievements_Title}" />

        <Grid Grid.Row="1" Margin="18,4,18,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock
                        FontSize="18"
                        FontWeight="Bold"
                        Text="{Binding GameName}"
                        TextTrimming="CharacterEllipsis" />
                    <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                        <TextBlock
                            FontSize="11.5"
                            Foreground="#9ca3af"
                            Text="{Binding AppId, StringFormat={x:Static res:Strings.Common_AppId}}" />
                        <TextBlock Margin="8,0" Foreground="#4b5563" Text="•" />
                        <TextBlock
                            FontSize="11.5"
                            Foreground="#9ca3af"
                            Text="{Binding SourceLabel, StringFormat={x:Static res:Strings.Achievements_Source}}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock
                    Grid.Column="1"
                    Margin="16,4,0,0"
                    VerticalAlignment="Top"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="#a78bfa"
                    Text="{Binding ProgressText}" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,16,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ProgressBar
                    Height="6"
                    Maximum="{Binding TotalCount}"
                    Value="{Binding EarnedCount}" />
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox
                        Icon="{ui:SymbolIcon Search24}"
                        PlaceholderText="{x:Static res:Strings.Achievements_Search}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        Command="{Binding SyncToSteamCommand}"
                        Content="{x:Static res:Strings.Achievements_SyncSteam}"
                        Icon="{ui:SymbolIcon CloudArrowUp24}"
                        IsEnabled="{Binding CanSyncToSteam}"
                        Visibility="{Binding SupportsSteamSync, Converter={StaticResource BoolToVis}}" />
                    <ui:Button
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        Command="{Binding PreviewCommand}"
                        Content="{x:Static res:Strings.Achievements_Preview}"
                        Icon="{ui:SymbolIcon Star24}" />
                    <ui:Button
                        Grid.Column="3"
                        Margin="8,0,0,0"
                        Command="{Binding RefreshCommand}"
                        Content="{x:Static res:Strings.Manage_Refresh}"
                        Icon="{ui:SymbolIcon ArrowSync24}" />
                </Grid>
                <TextBlock
                    Grid.Row="2"
                    Margin="0,8,0,0"
                    FontSize="11.5"
                    Foreground="#a78bfa"
                    Text="{Binding SyncStatus}"
                    TextWrapping="Wrap"
                    Visibility="{Binding SyncStatus, Converter={StaticResource NullToCollapsed}}" />
            </Grid>

            <Grid Grid.Row="2">
                <ScrollViewer
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="12"
                                Background="#0DFFFFFF"
                                BorderBrush="#1FFFFFFF"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid
                                        Width="64"
                                        Height="64"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top">
                                        <Border
                                            Background="#18000000"
                                            ClipToBounds="True"
                                            CornerRadius="7">
                                            <Image
                                                Source="{Binding Icon}"
                                                Stretch="UniformToFill">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Opacity" Value="1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Earned}" Value="False">
                                                                <Setter Property="Opacity" Value="0.32" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Border>
                                        <Border
                                            Width="22"
                                            Height="22"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Background="#dd111827"
                                            CornerRadius="11">
                                            <ui:SymbolIcon
                                                FontSize="17"
                                                Foreground="#4ade80"
                                                Symbol="CheckmarkCircle24"
                                                Visibility="{Binding Earned, Converter={StaticResource BoolToVis}}" />
                                        </Border>
                                        <Border
                                            Width="22"
                                            Height="22"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Background="#dd111827"
                                            CornerRadius="11"
                                            Visibility="{Binding Earned, Converter={StaticResource InverseBoolToVis}}">
                                            <ui:SymbolIcon
                                                FontSize="17"
                                                Foreground="#9ca3af"
                                                Symbol="DismissCircle24" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock
                                            FontSize="13.5"
                                            FontWeight="SemiBold"
                                            Text="{Binding DisplayName}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Margin="0,3,0,0"
                                            FontSize="11.5"
                                            Foreground="#9ca3af"
                                            Text="{Binding Description}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Border
                                        Grid.Column="2"
                                        Padding="8,3"
                                        VerticalAlignment="Top"
                                        Background="#1822c55e"
                                        CornerRadius="10"
                                        Visibility="{Binding Earned, Converter={StaticResource BoolToVis}}">
                                        <TextBlock
                                            FontSize="10.5"
                                            FontWeight="SemiBold"
                                            Foreground="#4ade80"
                                            Text="{x:Static res:Strings.Achievements_Earned}" />
                                    </Border>
                                    <Border
                                        Grid.Column="2"
                                        Padding="8,3"
                                        VerticalAlignment="Top"
                                        Background="#186b7280"
                                        CornerRadius="10"
                                        Visibility="{Binding Earned, Converter={StaticResource InverseBoolToVis}}">
                                        <TextBlock
                                            FontSize="10.5"
                                            FontWeight="SemiBold"
                                            Foreground="#9ca3af"
                                            Text="{x:Static res:Strings.Achievements_Locked}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <ui:ProgressRing
                        Width="30"
                        Height="30"
                        HorizontalAlignment="Center"
                        IsIndeterminate="True" />
                    <TextBlock
                        Margin="0,10,0,0"
                        Foreground="#9ca3af"
                        Text="{x:Static res:Strings.Common_Loading}" />
                </StackPanel>

                <TextBlock
                    Margin="30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="#f87171"
                    Text="{Binding Error}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />

                <TextBlock
                    Margin="30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="#9ca3af"
                    Text="{x:Static res:Strings.Achievements_Empty}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Margin="0,0,14,0"
                    VerticalAlignment="Center"
                    FontSize="10.5"
                    Foreground="#6b7280"
                    Text="{Binding StatePath, StringFormat={x:Static res:Strings.Achievements_StatePath}}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding StatePath}"
                    Visibility="{Binding StatePath, Converter={StaticResource NullToCollapsed}}" />
                <ui:Button
                    Grid.Column="1"
                    Command="{Binding CloseCommand}"
                    Content="{x:Static res:Strings.Achievements_Close}" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>

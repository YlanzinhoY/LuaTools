<ui:FluentWindow
    x:Class="LuaToolsGui.Views.CanIRunItDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    Title="{x:Static res:Strings.CanIRunIt_Title}"
    Width="880"
    Height="720"
    MinWidth="700"
    MinHeight="560"
    d:DataContext="{d:DesignInstance Type=vm:CanIRunItViewModel}"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="CanResize"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{x:Static res:Strings.CanIRunIt_Title}" />

        <Grid Grid.Row="1" Margin="20,6,20,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock
                    FontSize="18"
                    FontWeight="Bold"
                    Text="{Binding GameName}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="11.5"
                    Foreground="#9ca3af"
                    Text="{Binding AppId, StringFormat={x:Static res:Strings.Common_AppId}}" />
            </StackPanel>

            <!-- API key gate. The key is passed to the Go process through its environment only. -->
            <Border
                Grid.Row="1"
                MaxWidth="560"
                Margin="0,26,0,0"
                Padding="22"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="#15FFFFFF"
                BorderBrush="#24FFFFFF"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="{Binding NeedsApiKey, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <ui:SymbolIcon
                        HorizontalAlignment="Center"
                        FontSize="32"
                        Foreground="#a78bfa"
                        Symbol="Key24" />
                    <TextBlock
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="{x:Static res:Strings.CanIRunIt_KeyTitle}" />
                    <TextBlock
                        Margin="0,7,0,0"
                        Foreground="#9ca3af"
                        LineHeight="18"
                        Text="{x:Static res:Strings.CanIRunIt_KeyHint}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <PasswordBox
                        x:Name="ApiKeyBox"
                        Height="34"
                        Margin="0,16,0,0"
                        Padding="8,5"
                        VerticalContentAlignment="Center"
                        PasswordChar="●" />
                    <CheckBox
                        x:Name="RememberKeyBox"
                        Margin="0,10,0,0"
                        Content="{x:Static res:Strings.CanIRunIt_RememberKey}"
                        IsChecked="True" />
                    <TextBlock
                        Margin="0,10,0,0"
                        Foreground="#f87171"
                        Text="{Binding Error}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />
                    <StackPanel Margin="0,16,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                        <ui:Button
                            Click="OpenRouterKeys_Click"
                            Content="{x:Static res:Strings.CanIRunIt_GetKey}"
                            Icon="{ui:SymbolIcon Open24}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Appearance="Primary"
                            Click="Analyze_Click"
                            Content="{x:Static res:Strings.CanIRunIt_Analyze}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Hardware collection + Steam + OpenRouter request. -->
            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <ui:ProgressRing Width="34" Height="34" IsIndeterminate="True" />
                <TextBlock
                    Margin="0,12,0,0"
                    Foreground="#d1d5db"
                    Text="{x:Static res:Strings.CanIRunIt_Analyzing}" />
                <TextBlock
                    Margin="0,5,0,0"
                    Foreground="#6b7280"
                    Text="{x:Static res:Strings.CanIRunIt_AnalyzingHint}" />
            </StackPanel>

            <!-- Non-key errors retain the key in memory and can be retried. -->
            <StackPanel
                Grid.Row="1"
                MaxWidth="560"
                Margin="0,28,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsLoading}" Value="False" />
                                    <Condition Binding="{Binding NeedsApiKey}" Value="False" />
                                    <Condition Binding="{Binding Analysis}" Value="{x:Null}" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ui:SymbolIcon
                    HorizontalAlignment="Center"
                    FontSize="32"
                    Foreground="#f87171"
                    Symbol="Warning24" />
                <TextBlock
                    Margin="0,12,0,0"
                    Foreground="#fca5a5"
                    Text="{Binding Error}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <ui:Button
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    Click="Retry_Click"
                    Content="{x:Static res:Strings.CanIRunIt_Retry}" />
            </StackPanel>

            <!-- Result -->
            <ScrollViewer
                Grid.Row="1"
                Margin="0,18,0,0"
                VerticalScrollBarVisibility="Auto"
                Visibility="{Binding Analysis, Converter={StaticResource NullToCollapsed}}">
                <StackPanel Margin="0,0,8,8" DataContext="{Binding Analysis}">
                    <Border Padding="16" BorderThickness="1" CornerRadius="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#1422c55e" />
                                <Setter Property="BorderBrush" Value="#5534d399" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Verdict}" Value="minimum">
                                        <Setter Property="Background" Value="#14eab308" />
                                        <Setter Property="BorderBrush" Value="#55facc15" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Verdict}" Value="poor">
                                        <Setter Property="Background" Value="#14f97316" />
                                        <Setter Property="BorderBrush" Value="#55fb923c" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Verdict}" Value="unsupported">
                                        <Setter Property="Background" Value="#14ef4444" />
                                        <Setter Property="BorderBrush" Value="#55f87171" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid>
                                <TextBlock FontSize="18" FontWeight="Bold" Text="{Binding VerdictLabel}" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="#9ca3af"
                                    Text="{Binding ConfidenceLabel}" />
                            </Grid>
                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="13"
                                LineHeight="19"
                                Text="{Binding Summary}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,18,0,8" FontSize="14" FontWeight="SemiBold" Text="{x:Static res:Strings.CanIRunIt_YourHardware}" />
                    <Border Padding="14" Background="#0DFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="8">
                        <Grid DataContext="{Binding Hardware}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Foreground="#6b7280" Text="CPU" />
                            <TextBlock Grid.Column="1" Text="{Binding CpuSummary}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" Margin="0,7,0,0" Foreground="#6b7280" Text="GPU" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,7,0,0" Text="{Binding GpuSummary}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="2" Margin="0,7,0,0" Foreground="#6b7280" Text="RAM" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,7,0,0" Text="{Binding MemorySummary}" />
                            <TextBlock Grid.Row="3" Margin="0,7,0,0" Foreground="#6b7280" Text="OS" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,7,0,0" Text="{Binding Os}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="4" Margin="0,7,0,0" Foreground="#6b7280" Text="{x:Static res:Strings.CanIRunIt_StorageFree}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,7,0,0" Text="{Binding StorageSummary}" />
                        </Grid>
                    </Border>

                    <TextBlock Margin="0,18,0,8" FontSize="14" FontWeight="SemiBold" Text="{x:Static res:Strings.CanIRunIt_ComponentCheck}" />
                    <ItemsControl ItemsSource="{Binding Components}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" Padding="12" Background="#0DFFFFFF" CornerRadius="7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Component}" />
                                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding StatusLabel}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#9ca3af" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="exceeds"><Setter Property="Foreground" Value="#34d399" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="meets"><Setter Property="Foreground" Value="#a3e635" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="below"><Setter Property="Foreground" Value="#fb923c" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Foreground="#d1d5db" Text="{Binding Explanation}" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Margin="0,12,0,0" Visibility="{Binding HasRecommendations, Converter={StaticResource BoolToVis}}">
                        <TextBlock Margin="0,0,0,7" FontSize="14" FontWeight="SemiBold" Text="{x:Static res:Strings.CanIRunIt_Recommendations}" />
                        <ItemsControl ItemsSource="{Binding Recommendations}">
                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="8,2,0,2" Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0" Visibility="{Binding HasCaveats, Converter={StaticResource BoolToVis}}">
                        <TextBlock Margin="0,0,0,7" FontSize="14" FontWeight="SemiBold" Text="{x:Static res:Strings.CanIRunIt_Caveats}" />
                        <ItemsControl ItemsSource="{Binding Caveats}">
                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="8,2,0,2" Foreground="#9ca3af" Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Expander Margin="0,16,0,0" Header="{x:Static res:Strings.CanIRunIt_PublishedRequirements}">
                        <Grid Margin="0,10,0,0" DataContext="{Binding Requirements}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Padding="12" Background="#0DFFFFFF" CornerRadius="7">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.CanIRunIt_Minimum}" />
                                    <TextBlock Margin="0,7,0,0" Foreground="#9ca3af" Text="{Binding MinimumDisplay}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Padding="12" Background="#0DFFFFFF" CornerRadius="7">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.CanIRunIt_Recommended}" />
                                    <TextBlock Margin="0,7,0,0" Foreground="#9ca3af" Text="{Binding RecommendedDisplay}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Expander>

                    <TextBlock
                        Margin="0,14,0,0"
                        FontSize="10.5"
                        Foreground="#6b7280"
                        Text="{x:Static res:Strings.CanIRunIt_Disclaimer}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2" Margin="20,8,20,16">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="10.5"
                Foreground="#6b7280"
                Text="OpenRouter · free model" />
            <ui:Button
                HorizontalAlignment="Right"
                Click="Close_Click"
                Content="{x:Static res:Strings.CanIRunIt_Close}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
